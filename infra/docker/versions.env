# Image versions for the H3 stack. Every tag is pinned so a rerun gets the same
# bytes. `make stack-freeze` resolves these tags to digests once the stack has
# been brought up on a Docker host, and that digest file is what §4.4 freezes.
MINIO_VERSION=RELEASE.2024-06-13T22-53-53Z
MINIO_MC_VERSION=RELEASE.2024-06-12T14-34-03Z
ICEBERG_REST_VERSION=1.8.1
SPARK_ICEBERG_VERSION=3.5.5_1.8.1
